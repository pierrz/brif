# Placeholders only: names and shape of the Secret, never a real value.
#   cp secret.yaml.example secret.yaml     (secret.yaml is git-ignored)
# Replace every CHANGE_ME, then:  kubectl apply -f deploy/k8s/secret.yaml
# Do not put the filled-in file in a repository. For a team, create the same Secret with your secret tooling
# (sealed-secrets, external-secrets, SOPS, ...): the pods only need a Secret called brif-secret with these keys.
apiVersion: v1
kind: Secret
metadata:
  name: brif-secret
  namespace: brif
  labels:
    app.kubernetes.io/name: brif-secret
    app.kubernetes.io/part-of: brif
type: Opaque
stringData:
  # Superuser of PostgreSQL (the image creates it on the first start, with the empty data directory).
  POSTGRES_PASSWORD: CHANGE_ME_postgres_superuser_password

  # Password of the application role DB_USER (configmap.yaml): the init script of postgres.yaml creates the role with it,
  # the API and the worker connect with it.
  DB_PASSWORD: CHANGE_ME_application_database_password

  # Signs the session cookies of the API. Any long random string, for instance: openssl rand -hex 32
  SECRET_KEY: CHANGE_ME_long_random_string

  # Password of the RabbitMQ user 'brif' (RABBITMQ_DEFAULT_USER in rabbitmq.yaml). RabbitMQ creates the user on its first start,
  # with an empty data volume: changing the password here later does not change it in an existing broker.
  RABBITMQ_DEFAULT_PASS: CHANGE_ME_rabbitmq_password

  # Celery: the broker is the RabbitMQ Service, with the user and the password above (URL-encode special characters in
  # the password; the final '//' is the default virtual host '/').
  CELERY_BROKER_URL: amqp://brif:CHANGE_ME_rabbitmq_password@rabbitmq:5672//
